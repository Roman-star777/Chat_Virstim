# Усі значення вводяться в Vercel → Project → Settings → Environment Variables.
# Сюди справжні значення НЕ записувати.

# Токен бота від @BotFather (потрібен, щоб перевіряти підпис Telegram)
TELEGRAM_BOT_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → API → JWT Secret (для пропуску з RLS)
SUPABASE_JWT_SECRET=

# Telegram user_id Романа: перша людина, яка має доступ і підтверджує інших
BOOTSTRAP_TG_USER_ID=
